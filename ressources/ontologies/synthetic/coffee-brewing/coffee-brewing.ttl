coffee-brewing:isDrivenBy a owl:ObjectProperty ;
    rdfs:domain coffee-brewing:ExtractionProcess ;
    rdfs:range coffee-brewing:BrewingParameter .

coffee-brewing:isExhibitedBy a owl:ObjectProperty ;
    rdfs:domain coffee-brewing:CoffeeBeverage ;
