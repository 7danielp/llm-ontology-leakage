    rdfs:domain coffee-brewing:SensoryExperience ;
    rdfs:range coffee-brewing:SensoryExperience .

coffee-brewing:isCategorizedAs a owl:ObjectProperty ;
    rdfs:domain coffee-brewing:RoastProfile ;
    rdfs:range coffee-brewing:RoastProfile .

coffee-brewing:isComponentOf a owl:ObjectProperty ;
    rdfs:domain coffee-brewing:BrewingDevice ;
    rdfs:range coffee-brewing:BrewingDevice .

coffee-brewing:isComposedOf a owl:ObjectProperty ;
    rdfs:domain coffee-brewing:CoffeeBeverage ;
    rdfs:range coffee-brewing:SolubleCompound .

coffee-brewing:isDerivedFrom a owl:ObjectProperty ;
    rdfs:domain coffee-brewing:CoffeeBean ;
    rdfs:range coffee-brewing:CoffeeBean .

coffee-brewing:isDescribedBy a owl:ObjectProperty ;
    rdfs:domain coffee-brewing:SensoryExperience ;
