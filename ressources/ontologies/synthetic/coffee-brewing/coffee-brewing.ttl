coffee-brewing:Grinder a owl:Class ;
    rdfs:subClassOf coffee-brewing:BrewingDevice .

coffee-brewing:AromaCompound a owl:Class ;
    rdfs:subClassOf coffee-brewing:SensoryExperience,
        coffee-brewing:SolubleCompound .

coffee-brewing:FilterMedia a owl:Class ;
    rdfs:subClassOf coffee-brewing:BrewingDevice .

coffee-brewing:WaterSource a owl:Class ;
    rdfs:subClassOf coffee-brewing:WaterMineralProfile .

coffee-brewing:BitternessComponent a owl:Class ;
