@prefix coffee-brewing: <http://example.org/coffee-brewing#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

coffee-brewing:affects a owl:ObjectProperty ;
    rdfs:domain coffee-brewing:BrewingParameter ;
    rdfs:range coffee-brewing:SensoryExperience .

coffee-brewing:characterizedBy a owl:ObjectProperty ;
    rdfs:domain coffee-brewing:CoffeeBeverage ;
    rdfs:range coffee-brewing:RoastProfile .

coffee-brewing:consistsOf a owl:ObjectProperty ;
    rdfs:domain coffee-brewing:CoffeeBeverage ;
    rdfs:range coffee-brewing:SolubleCompound .

coffee-brewing:contains a owl:ObjectProperty ;
    rdfs:domain coffee-brewing:CoffeeBeverage ;
    rdfs:range coffee-brewing:SolubleCompound .

coffee-brewing:controls a owl:ObjectProperty ;
    rdfs:domain coffee-brewing:BrewingParameter ;
    rdfs:range coffee-brewing:ExtractionProcess .

coffee-brewing:creates a owl:ObjectProperty ;
    rdfs:domain coffee-brewing:ExtractionProcess ;
    rdfs:range coffee-brewing:CoffeeBeverage .

coffee-brewing:defines a owl:ObjectProperty ;
    rdfs:domain coffee-brewing:RoastProfile ;
