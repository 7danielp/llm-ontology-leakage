coffee-brewing:hasFilter a owl:ObjectProperty ;
    rdfs:domain coffee-brewing:BrewingDevice ;
    rdfs:range coffee-brewing:FilterMedia .

coffee-brewing:hasFlavor a owl:ObjectProperty ;
    rdfs:domain coffee-brewing:SensoryExperience ;
    rdfs:range coffee-brewing:FlavorCompound .

coffee-brewing:hasGrindSize a owl:ObjectProperty ;
    rdfs:domain coffee-brewing:CoffeeBean ;
