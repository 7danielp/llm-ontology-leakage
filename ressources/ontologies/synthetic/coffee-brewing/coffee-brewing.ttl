coffee-brewing:CoffeeBean a owl:Class ;
    rdfs:subClassOf coffee-brewing:RoastProfile .

coffee-brewing:CoffeeBeverage a owl:Class .

coffee-brewing:SolubleCompound a owl:Class ;
    rdfs:subClassOf coffee-brewing:ExtractionProcess .

coffee-brewing:BrewingMethod a owl:Class ;
    rdfs:subClassOf coffee-brewing:ExtractionProcess .

coffee-brewing:ExtractionProcess a owl:Class .

coffee-brewing:SensoryExperience a owl:Class ;
    rdfs:subClassOf coffee-brewing:CoffeeBeverage .

coffee-brewing:BrewingParameter a owl:Class .

