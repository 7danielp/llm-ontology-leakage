coffee-brewing:isRepresentedBy a owl:ObjectProperty ;
    rdfs:domain coffee-brewing:RoastProfile ;
    rdfs:range coffee-brewing:RoastProfile .

coffee-brewing:isSubtypeOf a owl:ObjectProperty ;
