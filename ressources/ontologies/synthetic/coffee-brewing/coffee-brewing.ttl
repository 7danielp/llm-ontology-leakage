coffee-brewing:AcidityComponent a owl:Class ;
    rdfs:subClassOf coffee-brewing:SensoryExperience,
        coffee-brewing:SolubleCompound .

coffee-brewing:BodyComponent a owl:Class ;
    rdfs:subClassOf coffee-brewing:SensoryExperience,
        coffee-brewing:SolubleCompound .

coffee-brewing:BrewingRatio a owl:Class ;
