@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix weather-patterns: <http://example.org/weather-patterns#> .

weather-patterns:Blizzard a owl:Class ;
    rdfs:subClassOf weather-patterns:ExtremeWeatherEvent .

weather-patterns:ColdFront a owl:Class ;
    rdfs:subClassOf weather-patterns:FrontalSystem .

weather-patterns:Drought a owl:Class ;
    rdfs:subClassOf weather-patterns:ExtremeWeatherEvent .

weather-patterns:Flood a owl:Class ;
    rdfs:subClassOf weather-patterns:ExtremeWeatherEvent .

weather-patterns:Heatwave a owl:Class ;
    rdfs:subClassOf weather-patterns:ExtremeWeatherEvent .

weather-patterns:OccludedFront a owl:Class ;
    rdfs:subClassOf weather-patterns:FrontalSystem .

weather-patterns:StationaryFront a owl:Class ;
    rdfs:subClassOf weather-patterns:FrontalSystem .

weather-patterns:Thunderstorm a owl:Class ;
    rdfs:subClassOf weather-patterns:StormSystem .

weather-patterns:Tornado a owl:Class ;
    rdfs:subClassOf weather-patterns:ExtremeWeatherEvent .

weather-patterns:WarmFront a owl:Class ;
    rdfs:subClassOf weather-patterns:FrontalSystem .

weather-patterns:associatedWith a owl:ObjectProperty ;
    rdfs:domain weather-patterns:AtmosphericPhenomenon ;
    rdfs:range weather-patterns:AtmosphericPhenomenon .

weather-patterns:causes a owl:ObjectProperty ;
    rdfs:domain weather-patterns:MeteorologicalDriver ;
    rdfs:range weather-patterns:ExtremeWeatherEvent .

